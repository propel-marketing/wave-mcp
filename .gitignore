# ─── Build output / dependencies ─────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ─── Test + coverage artefacts ───────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Secrets / environment ───────────────────────────────────────────────────
# Nothing in this project loads .env files; keep any local ones out of git regardless.
.env
.env.*

# Credentials should live in `~/.config/waveapps-mcp/credentials.json`, NOT here —
# but defensively block anything resembling a credential file from being added.
credentials.json
**/credentials.json
*.pem
*.key
auth.json
secrets.json

# ─── Editor / IDE state ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── Claude Code project-local state ─────────────────────────────────────────
.claude/

# ─── npm / pnpm / yarn debug logs ────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Misc local-only ─────────────────────────────────────────────────────────
NOTES.md
*.local

# ─── Reverse-engineering notes — kept locally, not for the public repo ───────
# `docs/` documents Wave's internal endpoints + verbatim GraphQL queries we
# captured during development. Useful reference for you, sensitive if leaked
# (could be used to abuse Wave's internal API). Kept out of git deliberately.
docs/*
!docs/planning/
docs/planning/*
!docs/planning/v1/
!docs/planning/v2/

# ADW local databases and mutable runtime receipts are never publication inputs.
.agents/data/
.agents/active-plans.json
.agents/runs/*/task-list.json
.agents/runs/*/agent-outputs/*/
!.agents/runs/*/agent-outputs/planner/
.agents/runs/*/agent-outputs/planner/*
!.agents/runs/*/agent-outputs/planner/00_intake_manifest.md
!.agents/runs/*/agent-outputs/planner/01_phase_structure.md


# ─── Python (gateway/) ───────────────────────────────────────────────────────
.venv/
__pycache__/
.pytest_cache/
